<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">

   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Huninn&display=swap" rel="stylesheet">

   <title>User | Linked Branch</title>
   <link rel="stylesheet" href="/css/reset.css">
   <link rel="stylesheet" href="/css/style.css">
   <script src="/script.js" defer></script>
</head>

<body>

   <main class="user-page-main flex justify-center">

      <div class="user-content flex-column">

         <div class="profile-header flex-column center">

            <div class="user-profile-icon aspect-square"></div>
            <h1 class="user-name-label">ItsCiaPro</h1>

            <p class="user-about-label">
               Um estudante de Ciência da Computação focado em aprender algo novo todo dia!
            </p>

            <div class="social-icons-container flex-row center">
               <img src="/assets/imgs/icons/discord-icon.png" alt="Social Icon">
               <img src="/assets/imgs/icons/youtube-icon.png" alt="Social Icon">
               <img src="/assets/imgs/icons/linkedin-icon.png" alt="Social Icon">
               <img src="/assets/imgs/icons/tiktok-icon.png" alt="Social Icon">
               <img src="/assets/imgs/icons/reddit-icon.png" alt="Social Icon">
               <img src="/assets/imgs/icons/tumblr-icon.png" alt="Social Icon">
               <img src="/assets/imgs/icons/x-icon.png" alt="Social Icon">
               <img src="/assets/imgs/icons/instagram-icon.png" alt="Social Icon">
               <img src="/assets/imgs/icons/facebook-icon.png" alt="Social Icon">
            </div>

         </div>

         <div class="linked-button-list flex-column" id="linked-button-list">
            <!-- 
               <button class="linked-button">
                  <p>First Link</p>
               </button>
            -->
         </div>

         <div class="linkedbranch-logo flex-row">
            <div class="logo"></div>
            <p>Linked Branch</p>
         </div>
      </div>
   </main>
</body>

</html>